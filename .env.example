# Скопируй в Railway Variables (не коммить реальные значения)

WB_TOKEN=
# Cookie с www.wildberries.ru для «НОВЫЕ ОСТАТКИ».
# DevTools → карточка товара на wildberries.ru → Network → __internal/card → Request Headers → cookie.
WB_SITE_COOKIE=
# Опционально, если WB обновил SPA (по умолчанию 14.22.5)
# WB_SPA_VERSION=14.22.5
# Свои артикулы для «НОВЫЕ ОСТАТКИ» (JSON-массив). Без переменной — дефолт из кода.
# NEW_STOCK_ARTICLES_JSON=[{"vendor_code":"ART-1","nm_id":123456789},{"vendor_code":"ART-2","nm_id":987654321}]
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=

# Опционально: Google Sheets «Наш склад» (доступ «все у кого есть ссылка»)
OWN_WAREHOUSE_SHEET_ID=
OWN_WAREHOUSE_GID=

# Vi-Smart Studio (/studio) — три входа
STUDIO_VLAD_PASSWORD=
STUDIO_WB_PASSWORD=
STUDIO_OZON_PASSWORD=
