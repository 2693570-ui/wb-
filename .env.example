# Скопируй в Railway Variables (не коммить реальные значения)

WB_TOKEN=
# Cookie с www.wildberries.ru для «НОВЫЕ ОСТАТКИ» (полный список складов как MKeeper).
# DevTools → Network → любой запрос к wildberries.ru → Request Headers → cookie (вся строка).
# Или HAR: request.headers Cookie у __internal/card/.../detail. Периодически обновлять.
WB_SITE_COOKIE=
# Опционально, если WB обновил SPA (по умолчанию 14.22.5)
# WB_SPA_VERSION=14.22.5
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=

# Опционально: Google Sheets «Наш склад» (доступ «все у кого есть ссылка»)
OWN_WAREHOUSE_SHEET_ID=
OWN_WAREHOUSE_GID=

# Vi-Smart Studio (/studio) — три входа
STUDIO_VLAD_PASSWORD=
STUDIO_WB_PASSWORD=
STUDIO_OZON_PASSWORD=
